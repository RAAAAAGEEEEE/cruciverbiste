# Seule variable requise. Copiez ce fichier en .env si vous utilisez un outil qui le charge,
# ou exportez la variable dans votre shell. Ne committez jamais la vraie valeur.
ANTHROPIC_API_KEY=

# Facultatif : remplace la commande `claude` (binaire hors du PATH, faux CLI pour les tests).
# CRUCIVERBISTE_CLAUDE_CMD=claude
